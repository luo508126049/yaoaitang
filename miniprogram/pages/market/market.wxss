.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 80rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.title,
.subtitle,
.name,
.desc,
.price,
.badge {
  display: block;
}

.title {
  color: #111;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 25rpx;
}

.hero {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: 26rpx;
  background: #fbf8ee;
}

.filters {
  white-space: nowrap;
  margin-bottom: 22rpx;
}

.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 62rpx;
  margin-right: 14rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 999rpx;
  color: #5f5b56;
  background: #fffdf6;
  font-size: 24rpx;
}

.filter.active {
  color: #fffdf6;
  border-color: #1f5446;
  background: #1f5446;
}

.state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
  color: #1f5446;
  font-size: 28rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.product-card {
  display: block;
  overflow: hidden;
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
  text-align: left;
  box-shadow: 0 8rpx 20rpx rgba(31, 84, 70, .08);
}

.product-card:active {
  transform: scale(.98);
}

.product-card image {
  display: block;
  width: 100%;
  height: 210rpx;
  background: #fbf8ee;
}

.product-main {
  padding: 18rpx 18rpx 20rpx;
}

.badge {
  width: max-content;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #1f5446;
  background: #edf5ef;
  font-size: 20rpx;
}

.name,
.desc {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.name {
  margin-top: 12rpx;
  color: #111;
  font-size: 28rpx;
  font-weight: 800;
}

.desc {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 23rpx;
}

.price {
  margin-top: 14rpx;
  color: #9b650e;
  font-size: 32rpx;
  font-weight: 800;
}
