<view class="page">
  <view class="topbar">
    <button class="back" bindtap="onBack">‹</button>
    <view>
      <text class="title">非遗大集</text>
      <text class="subtitle">古法艾条、非遗礼盒和养生好物</text>
    </view>
  </view>

  <image class="hero" src="/images/card-market.png" mode="aspectFill" />

  <scroll-view class="filters" scroll-x>
    <button
      wx:for="{{filters}}"
      wx:key="*this"
      class="filter {{activeFilter === item ? 'active' : ''}}"
      data-value="{{item}}"
      bindtap="onFilterTap"
    >{{item}}</button>
  </scroll-view>

  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:else class="grid">
    <button wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="onProductTap">
      <image src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="product-main">
        <text class="badge">{{item.badge}}</text>
        <text class="name">{{item.name}}</text>
        <text class="desc">{{item.subtitle}}</text>
        <text class="price">¥{{item.displayPrice}}</text>
      </view>
    </button>
  </view>
</view>
