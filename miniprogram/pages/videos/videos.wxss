.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 80rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #111;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 25rpx;
}

.video-card {
  position: relative;
  display: block;
  width: 100%;
  margin-bottom: 26rpx;
  overflow: hidden;
  border: 2rpx solid #eadfc5;
  border-radius: 24rpx;
  background: #fffdf8;
  text-align: left;
  box-shadow: 0 8rpx 20rpx rgba(31, 84, 70, .08);
}

.video-card:active {
  transform: scale(.98);
}

.video-card image {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #fbf8ee;
}

.play {
  position: absolute;
  left: 50%;
  top: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-left: -46rpx;
  margin-top: -46rpx;
  border-radius: 50%;
  color: #fffdf6;
  background: rgba(31, 84, 70, .88);
  font-size: 34rpx;
}

.video-main {
  padding: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.video-title {
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.length {
  color: #a67c3e;
  font-size: 24rpx;
}

.summary {
  display: block;
  margin-top: 12rpx;
  color: #5c5148;
  font-size: 26rpx;
  line-height: 1.6;
}
