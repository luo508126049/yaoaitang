.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 80rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.title,
.subtitle,
.name,
.desc,
.origin {
  display: block;
}

.title {
  color: #111;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 25rpx;
}

.hero {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: 26rpx;
  background: #fbf8ee;
}

.state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
  color: #1f5446;
  font-size: 28rpx;
}

.group-card {
  display: flex;
  min-height: 210rpx;
  margin-bottom: 22rpx;
  padding: 18rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 20rpx rgba(31, 84, 70, .08);
}

.group-card image {
  width: 180rpx;
  height: 174rpx;
  border-radius: 18rpx;
  background: #fbf8ee;
}

.main {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.name,
.desc {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.name {
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
}

.desc {
  margin-top: 10rpx;
  color: #776d61;
  font-size: 24rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 22rpx;
}

.group-price {
  color: #9b650e;
  font-size: 36rpx;
  font-weight: 800;
}

.origin {
  margin-top: 4rpx;
  color: #999;
  font-size: 22rpx;
  text-decoration: line-through;
}

.price-row button {
  width: 138rpx;
  height: 64rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #1f5446;
  font-size: 25rpx;
  font-weight: 800;
}
