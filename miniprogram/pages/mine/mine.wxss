.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 150rpx;
  background: #f8f5e9;
  color: #20170f;
}

.profile {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 34rpx rgba(31, 84, 70, .10);
}

.mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.profile-main {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.name,
.desc {
  display: block;
}

.name {
  color: #111;
  font-size: 36rpx;
  font-weight: 800;
}

.desc {
  margin-top: 10rpx;
  color: #776d61;
  font-size: 25rpx;
}

.logout {
  width: 108rpx;
  height: 58rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 999rpx;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 24rpx;
  padding: 24rpx 0;
  border: 2rpx solid #eadfc5;
  border-radius: 24rpx;
  background: #fffdf8;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  color: #1f5446;
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #776d61;
  font-size: 23rpx;
}

.section-title {
  margin: 38rpx 0 18rpx;
  color: #111;
  font-size: 34rpx;
  font-weight: 800;
}

.cell-list {
  border: 2rpx solid #eadfc5;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fffdf8;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 116rpx;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid #efe6d2;
  text-align: left;
}

.cell:last-child {
  border-bottom: 0;
}

.cell-title,
.cell-sub {
  display: block;
}

.cell-title {
  color: #111;
  font-size: 29rpx;
  font-weight: 800;
}

.cell-sub {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 23rpx;
}

.arrow {
  color: #a67c3e;
  font-size: 44rpx;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  height: 118rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e1d7c5;
  background: rgba(255, 253, 248, .98);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 29rpx;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 4rpx;
}

.tab-item.active {
  color: #a67c3e;
  font-weight: 700;
}
