.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 80rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #111;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 25rpx;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  color: #fffdf6;
  background: #1f5446;
}

.hero-title,
.hero-sub {
  display: block;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 12rpx;
  color: rgba(255, 253, 246, .78);
  font-size: 26rpx;
}

.hero button {
  width: 260rpx;
  height: 72rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  color: #1f5446;
  background: #fffdf6;
  font-size: 27rpx;
  font-weight: 800;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 24rpx 0;
}

.metric,
.panel {
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
}

.metric {
  padding: 22rpx 8rpx;
  text-align: center;
}

.metric-value {
  display: block;
  color: #9b650e;
  font-size: 30rpx;
  font-weight: 800;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  color: #776d61;
  font-size: 22rpx;
}

.panel {
  margin-top: 22rpx;
  padding: 26rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111;
  font-size: 31rpx;
  font-weight: 800;
}

.panel-head button {
  width: 120rpx;
  height: 56rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #a67c3e;
  font-size: 24rpx;
}

.qr {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 190rpx;
  margin: 24rpx 0 14rpx;
  border: 2rpx dashed #d7c6a8;
  border-radius: 18rpx;
  color: #1f5446;
  background: #fbf8ee;
  font-size: 38rpx;
  font-weight: 800;
}

.hint,
.task,
.partner-amount {
  color: #776d61;
  font-size: 25rpx;
}

.panel-title {
  display: block;
  margin-bottom: 18rpx;
  color: #111;
  font-size: 31rpx;
  font-weight: 800;
}

.task {
  padding: 12rpx 0;
}

.partner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #efe6d2;
}

.partner-name,
.partner-amount {
  display: block;
}

.partner-name {
  color: #111;
  font-size: 28rpx;
  font-weight: 800;
}

.partner-amount {
  margin-top: 8rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #1f5446;
  background: #edf5ef;
  font-size: 22rpx;
}
