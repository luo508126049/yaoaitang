.page {
  min-height: 100vh;
  padding: 52rpx 28rpx;
  background: #f8f5e9;
  color: #20170f;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 130rpx;
  padding: 52rpx 34rpx 40rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 34rpx rgba(31, 84, 70, .10);
}

.brand-mark {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.title {
  margin-top: 30rpx;
  color: #111;
  font-size: 40rpx;
  font-weight: 800;
}

.subtitle {
  width: 520rpx;
  margin-top: 18rpx;
  color: #70675d;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.primary,
.ghost {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.primary {
  color: #fffdf6;
  background: #1f5446;
}

.ghost {
  margin-top: 18rpx;
  border: 2rpx solid #eae3d0;
  color: #a67c3e;
  background: #fffdf6;
}
