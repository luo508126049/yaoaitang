.page {
  min-height: 100vh;
  padding: 52rpx 28rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.top-title {
  color: #111;
  font-size: 36rpx;
  font-weight: 800;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  padding: 56rpx 36rpx 42rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 34rpx rgba(31, 84, 70, .10);
}

.mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  background: #f8f1df;
}

.mark image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
}

.title {
  margin-top: 34rpx;
  color: #1f5446;
  font-size: 42rpx;
  font-weight: 800;
}

.subtitle {
  width: 560rpx;
  margin-top: 18rpx;
  color: #70675d;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.primary {
  width: 100%;
  height: 88rpx;
  margin-top: 42rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #1f5446;
  font-size: 30rpx;
  font-weight: 800;
}
