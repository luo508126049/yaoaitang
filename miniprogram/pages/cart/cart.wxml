<view class="page">
  <view class="topbar">
    <view>
      <text class="title">购物车</text>
      <text class="subtitle">已选 {{totalCount}} 件曜艾堂好物</text>
    </view>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty">
    <text class="empty-title">购物车空空如也</text>
    <text class="empty-sub">去挑选艾条、礼盒和理疗套盒</text>
    <button bindtap="onGoShopping">去逛逛</button>
  </view>

  <view wx:else class="cart-list">
    <view wx:for="{{items}}" wx:key="id" class="cart-item">
      <button class="check {{item.selected !== false ? 'active' : ''}}" data-id="{{item.id}}" data-selected="{{item.selected !== false}}" bindtap="onToggle"></button>
      <image src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindtap="onProductTap" />
      <view class="main">
        <text class="name">{{item.name}}</text>
        <text class="desc">{{item.subtitle}}</text>
        <view class="price-row">
          <text class="price">¥{{item.lineTotal}}</text>
          <view class="stepper">
            <button data-id="{{item.id}}" bindtap="onMinus">-</button>
            <text>{{item.count}}</text>
            <button data-id="{{item.id}}" bindtap="onPlus">+</button>
          </view>
        </view>
        <button class="remove" data-id="{{item.id}}" bindtap="onRemove">移除</button>
      </view>
    </view>
  </view>

  <view class="settle">
    <button class="select-all" bindtap="onSelectAll">
      <view class="check {{allSelected ? 'active' : ''}}"></view>
      <text>全选</text>
    </button>
    <view class="total">
      <text>合计</text>
      <text class="amount">¥{{totalPrice}}</text>
    </view>
    <button class="checkout" bindtap="onCheckout">结算</button>
  </view>

  <view class="tabbar">
    <button wx:for="{{tabs}}" wx:key="key" class="tab-item {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTabTap">
      <image class="tab-icon" src="{{item.iconUrl}}" mode="aspectFit" />
      <text>{{item.label}}</text>
    </button>
  </view>
</view>
