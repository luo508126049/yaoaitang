.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 270rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  margin-bottom: 30rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #111;
  font-size: 40rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 25rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 24rpx;
  background: #fffdf8;
}

.empty-title {
  color: #1f5446;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-sub {
  margin-top: 14rpx;
  color: #776d61;
  font-size: 26rpx;
}

.empty button {
  width: 220rpx;
  height: 74rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #1f5446;
  font-size: 28rpx;
}

.cart-item {
  position: relative;
  display: flex;
  min-height: 210rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 18rpx 20rpx 78rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 20rpx rgba(31, 84, 70, .08);
}

.check {
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #d9ceb9;
  border-radius: 50%;
  background: #fffdf6;
}

.cart-item > .check {
  position: absolute;
  left: 24rpx;
  top: 88rpx;
}

.check.active {
  border-color: #1f5446;
  background: #1f5446;
}

.cart-item image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 18rpx;
  background: #fbf8ee;
}

.main {
  position: relative;
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.name,
.desc {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.name {
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
}

.desc {
  margin-top: 10rpx;
  color: #776d61;
  font-size: 24rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.price {
  color: #9b650e;
  font-size: 32rpx;
  font-weight: 800;
}

.stepper {
  display: flex;
  align-items: center;
  height: 56rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 999rpx;
  overflow: hidden;
}

.stepper button,
.stepper text {
  width: 54rpx;
  height: 56rpx;
  text-align: center;
  line-height: 56rpx;
  color: #1f5446;
  font-size: 28rpx;
}

.stepper text {
  color: #20170f;
  background: #fffaf0;
}

.remove {
  position: absolute;
  right: 0;
  bottom: 0;
  color: #999;
  font-size: 23rpx;
}

.settle {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 118rpx;
  z-index: 11;
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid #e1d7c5;
  background: rgba(255, 253, 248, .98);
}

.select-all {
  display: flex;
  align-items: center;
  width: 140rpx;
  color: #5f5b56;
  font-size: 26rpx;
}

.select-all .check {
  margin-right: 10rpx;
}

.total {
  flex: 1;
  text-align: right;
  color: #5f5b56;
  font-size: 24rpx;
}

.amount {
  margin-left: 10rpx;
  color: #9b650e;
  font-size: 34rpx;
  font-weight: 800;
}

.checkout {
  width: 170rpx;
  height: 72rpx;
  margin-left: 18rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #1f5446;
  font-size: 28rpx;
  font-weight: 800;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  height: 118rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e1d7c5;
  background: rgba(255, 253, 248, .98);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 29rpx;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 4rpx;
}

.tab-item.active {
  color: #a67c3e;
  font-weight: 700;
}
