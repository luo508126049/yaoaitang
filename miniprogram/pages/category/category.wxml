<view class="page">
  <view class="topbar">
    <view>
      <text class="title">全品类分类</text>
      <text class="subtitle">艾制品 / 理疗套盒 / 非遗礼盒</text>
    </view>
    <button class="search" bindtap="onSearchTap">搜索</button>
  </view>

  <view class="body">
    <scroll-view class="side" scroll-y>
      <button
        wx:for="{{categories}}"
        wx:key="key"
        class="side-item {{activeKey === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCategoryTap"
      >{{item.label}}</button>
    </scroll-view>

    <scroll-view class="content" scroll-y>
      <view wx:if="{{loading}}" class="state">加载中...</view>
      <view wx:elif="{{products.length === 0}}" class="state">暂无商品，换个分类试试</view>
      <block wx:else>
        <button
          wx:for="{{products}}"
          wx:key="id"
          class="product-card"
          data-id="{{item.id}}"
          bindtap="onProductTap"
        >
          <image src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="product-info">
            <text class="name">{{item.name}}</text>
            <text class="desc">{{item.subtitle}}</text>
            <view class="price-line">
              <text class="price">¥{{item.displayPrice}}</text>
              <text class="tag">查看</text>
            </view>
          </view>
        </button>
      </block>
    </scroll-view>
  </view>

  <view class="tabbar">
    <button wx:for="{{tabs}}" wx:key="key" class="tab-item {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTabTap">
      <image class="tab-icon" src="{{item.iconUrl}}" mode="aspectFit" />
      <text>{{item.label}}</text>
    </button>
  </view>
</view>
