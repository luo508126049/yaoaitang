<view class="page">
  <view class="topbar">
    <button class="back" bindtap="onBack">‹</button>
    <view>
      <text class="title">案例库</text>
      <text class="subtitle">艾灸调理图文案例</text>
    </view>
  </view>

  <scroll-view class="tabs" scroll-x>
    <button
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab {{active === item ? 'active' : ''}}"
      data-value="{{item}}"
      bindtap="onTabTap"
    >{{item}}</button>
  </scroll-view>

  <view class="case-list">
    <button wx:for="{{filteredCases}}" wx:key="title" class="case-card" data-index="{{index}}" bindtap="onCaseTap">
      <image src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="case-main">
        <view class="meta">
          <text>{{item.category}}</text>
          <text>{{item.days}}</text>
        </view>
        <text class="case-title">{{item.title}}</text>
        <text class="summary">{{item.summary}}</text>
      </view>
    </button>
  </view>
</view>
