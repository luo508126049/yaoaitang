.page {
  min-height: 100vh;
  padding: 52rpx 28rpx 80rpx;
  background: #f8f5e9;
  color: #20170f;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid #eae3d0;
  border-radius: 50%;
  color: #a67c3e;
  background: #fffdf6;
  font-size: 52rpx;
  line-height: 56rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #111;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 8rpx;
  color: #776d61;
  font-size: 25rpx;
}

.hero {
  display: block;
  width: 100%;
  height: 330rpx;
  border-radius: 26rpx;
  background: #fbf8ee;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #111;
  font-size: 34rpx;
  font-weight: 800;
}

.coupon {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 154rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
}

.coupon-title,
.coupon-desc {
  display: block;
}

.coupon-title {
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
}

.coupon-desc {
  width: 420rpx;
  margin-top: 10rpx;
  color: #776d61;
  font-size: 24rpx;
  line-height: 1.5;
}

.coupon-side {
  text-align: center;
}

.coupon-side text {
  display: block;
  color: #9b650e;
  font-size: 34rpx;
  font-weight: 800;
}

.coupon-side button {
  width: 112rpx;
  height: 54rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #1f5446;
  font-size: 23rpx;
}

.steps {
  border: 2rpx solid #eadfc5;
  border-radius: 22rpx;
  background: #fffdf8;
}

.step {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #efe6d2;
  color: #5c5148;
  font-size: 27rpx;
}

.step:last-child {
  border-bottom: 0;
}

.num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #fffdf6;
  background: #a67c3e;
  font-size: 22rpx;
  font-weight: 800;
}

.reserve {
  width: 100%;
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  color: #fffdf6;
  background: #1f5446;
  font-size: 30rpx;
  font-weight: 800;
}
