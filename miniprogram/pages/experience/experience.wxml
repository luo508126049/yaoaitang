<view class="page">
  <view class="topbar">
    <button class="back" bindtap="onBack">‹</button>
    <view>
      <text class="title">先灸后玉</text>
      <text class="subtitle">到店体验、核销券和理疗套盒</text>
    </view>
  </view>

  <image class="hero" src="/images/banner-experience.png" mode="aspectFill" />

  <view class="section-title">体验券</view>
  <view class="coupon-list">
    <view wx:for="{{coupons}}" wx:key="title" class="coupon">
      <view>
        <text class="coupon-title">{{item.title}}</text>
        <text class="coupon-desc">{{item.desc}}</text>
      </view>
      <view class="coupon-side">
        <text>{{item.value}}</text>
        <button data-title="{{item.title}}" bindtap="onClaim">领取</button>
      </view>
    </view>
  </view>

  <view class="section-title">体验流程</view>
  <view class="steps">
    <view wx:for="{{steps}}" wx:key="*this" class="step">
      <text class="num">{{index + 1}}</text>
      <text>{{item}}</text>
    </view>
  </view>

  <button class="reserve" bindtap="onReserve">预约门店体验</button>
</view>
