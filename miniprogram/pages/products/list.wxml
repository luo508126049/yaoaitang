<view class="page">
  <view class="topbar">
    <button class="back" bindtap="onBack">‹</button>
    <view>
      <text class="title">{{keyword ? '搜索结果' : '全部商品'}}</text>
      <text class="subtitle">{{keyword ? keyword : '伊尹艾 / 分销商品'}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card">加载中...</view>
  <view wx:elif="{{error}}" class="state-card error">{{error}}</view>
  <view wx:elif="{{products.length === 0}}" class="state-card">
    <text>未找到相关产品</text>
    <text class="state-sub">换个关键词试试</text>
  </view>

  <view wx:else class="product-list">
    <button wx:for="{{products}}" wx:key="id" class="product-row pressable" data-id="{{item.id}}" bindtap="onProductTap">
      <image src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="product-main">
        <text class="name">{{item.name}}</text>
        <text class="desc">{{item.subtitle}}</text>
        <view class="price-line">
          <text class="price">¥{{item.displayPrice}}</text>
          <text class="tag">非遗好物</text>
        </view>
      </view>
    </button>
  </view>
</view>
